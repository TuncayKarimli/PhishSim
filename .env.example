# Copy this file to .env and edit the values.

# --- Flask & Environment ---
# Set FLASK_ENV=production in production to enforce strong secrets and secure cookies.
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
TRUST_PROXY_HEADERS=true
CSRF_ENABLED=true

# --- Login Rate Limiting ---
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=60

# --- Enterprise SSO (Optional: Microsoft Entra ID, Google Workspace, Okta) ---
SSO_AUTO_PROVISION=true
SSO_DEFAULT_ROLE=viewer

ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=common

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=

# --- Database ---
# Default: local SQLite file. For MySQL (needs PyMySQL), use e.g.:
# DATABASE_URL=mysql+pymysql://user:password@localhost/phishsim
DATABASE_URL=sqlite:///phishsim.db

# --- Public URL used to build tracking links inside emails ---
BASE_URL=http://localhost:5000

# --- Fallback / Default SMTP Profile (seeded into SMTP Profiles table on first run) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- First admin account (created on first run) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# --- Repeat-Offender Automation ---
REPEAT_OFFENDER_DAYS=14

# --- Optional Webhook (Slack / Discord / SIEM) for event alerts ---
WEBHOOK_URL=
