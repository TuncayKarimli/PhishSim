# ---- Production demo env. Set these as environment variables in your host's
# ---- dashboard. Do NOT commit the filled-in version.

FLASK_ENV=production
SECRET_KEY=paste-the-generated-48-char-token-here
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_ENABLED=true
TRUST_PROXY_HEADERS=true

# Login brute-force protection
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=60

# Public URL the host assigns you (set AFTER first deploy, then redeploy).
# Tracking links in emails are built from this, so it MUST be your https URL.
BASE_URL=https://REPLACE-WITH-YOUR-PUBLIC-URL

# SQLite on the mounted persistent disk (survives restarts/redeploys for the week)
DATABASE_URL=sqlite:////app/instance/phishsim.db

# First admin, created on first boot
ADMIN_EMAIL=you@school.edu
ADMIN_PASSWORD=paste-the-generated-admin-password-here

# Real SMTP (Gmail app password shown; SendGrid works too - see DEPLOY.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_USE_TLS=true

# Keep scheduler ON in this single service (file-locked to one worker)
RUN_SCHEDULER=true
